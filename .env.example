# Copy to .env (never commit .env).
#   mock     → demo data, no backend (default)
#   supabase → real backend below
VITE_DATA_SOURCE=mock

# Local stack: run `npm run db:start` and copy "API URL" and the publishable key
# from `npm run db:status`. Never put the service_role / secret key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
